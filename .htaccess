# .htaccess — Bluehost / cPanel Shared Hosting
# Upload this file to your public_html root when you move to Bluehost
# ═══════════════════════════════════════════════════════════════════

# ── 1. Force HTTPS redirect ─────────────────────────────────────
RewriteEngine On

# Redirect HTTP → HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect www → non-www (optional, pick one canonical form)
# Uncomment whichever you want:

# Option A: Force NON-www  (hrexpressservice.com)
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Option B: Force WWW  (www.hrexpressservice.com)
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]


# ── 2. HTTP Security Headers ────────────────────────────────────
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Control referrer information
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # XSS protection (legacy browsers)
    Header always set X-XSS-Protection "1; mode=block"

    # HSTS: force HTTPS for 1 year (enable ONLY after SSL is confirmed working)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Permissions policy: disable unnecessary browser features
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Remove server version info (security through obscurity)
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>


# ── 3. Cache control for static assets ─────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On

    # Images - cache for 1 year
    ExpiresByType image/jpeg  "access plus 1 year"
    ExpiresByType image/webp  "access plus 1 year"
    ExpiresByType image/png   "access plus 1 year"
    ExpiresByType image/gif   "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    # CSS and JS - cache for 1 month
    ExpiresByType text/css        "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"

    # HTML - short cache so updates propagate
    ExpiresByType text/html "access plus 1 hour"

    # Fonts - cache for 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff  "access plus 1 year"
</IfModule>


# ── 4. Gzip compression ─────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
    AddOutputFilterByType DEFLATE image/svg+xml application/json
</IfModule>


# ── 5. Block sensitive file access ──────────────────────────────
# Prevent direct access to .py scripts and other non-web files
<FilesMatch "\.(py|sh|bat|env|git|log|sql|bak)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ── 6. Disable directory listing ────────────────────────────────
Options -Indexes

# ═══════════════════════════════════════════════════════════════════
